{
  "currency": "credits",
  "verified_at": "2026-10-08",
  "source": "Historical observations from 2026-10-08 only; bundled rates do not authorize submissions. Before every selected request use the current non-submitting estimate_image_cost / estimate_video_cost contract or verified account quote and record the exact one-job credits plus evidence with ledger.py price-set. Generation tools submit jobs and are never pricing probes.",
  "live_run": {
    "date": "2026-10-08",
    "charged": 111.12,
    "jobs": [
      "soul_2 2k 3:4 identity 0.12",
      "seedance_2_5 omni_reference 10 s 720p 4:3 plate 70",
      "remove_background on that plate 1",
      "seedance_2_5 draft 4 s 12",
      "hf_mult_replace_object 720p on a 96-frame pad 28"
    ],
    "note": "quoted = charged for every job; another chat on the same account spent 496 cr in the same window (foreign charges interleave in `transactions`)"
  },
  "rules": {
    "unit": "second = rate x billed seconds per job; image = per image; job = flat per job; take = flat per take; chars = ceil(chars / per_chars) x rate",
    "seconds": "ceil = ceil(d - eps) (integer-second video models; Genjutsu replace: always trim/pad the input to an exact integer); round = floor(d + 0.5) (Genjutsu motion_control: fraction <= 0.1 s -> do not pad, fill the <= 2 lost tail frames in code; else freeze-pad to ceil); exact = the seconds as given. A plan line with frames + fps is priced from the frames (the probed clip)",
    "min_s": "a shorter job is billed (or, with min_rule reject, refused) at min_s; allowed_s snaps up to the next allowed duration",
    "draft_res": "draft:true is billed at the 'draft' rate (else at draft_res) whatever resolution is passed",
    "finalize": "a plan line with finalize:true (draft_job_id of a completed draft) is a full job at finalize.res whatever resolution is passed; without a duration it prices finalize.default_s",
    "verified_live": "rate key -> what the live paid run of 2026-10-08 charged (VERIFIED, reconciled with transactions); `quote` lists these rates",
    "fixed_input": "billed by the INPUT video length (Genjutsu driving video, video_edit source); the cheaper alternative cannot shorten it; the quote reports these lines as 'fixed input (min-billed)' with no utilisation target",
    "genjutsu": "mt = motion transfer (F1b full-length takes get a full-take worst-case reserve), replace = object/person swap",
    "driving_fps": "the driving clip must be an export at this fps (frames.py export --fps 24, then pad); other fps lines get a warning",
    "reroll": "Execution reserves at most one full-price retry per required image/video job, subject to the finite hard cap and three image attempts per planned item. Failed and refunded attempts count. Legacy per-model reroll metadata only sizes a supported retry; it never authorizes submission.",
    "est": "true = estimate (no cost endpoint, or observed charges only); est_hi = upper bound per unit for the worst case",
    "size_factor": "generated seconds / unique screen seconds: [cheaper-alternative factor, upper sizing factor] (budget.md section 4)",
    "call": "the MCP call shape `ledger.py params` prints: tool, res_param (resolution|quality|mode|null), res_values, duration (integer billed seconds), aspect, count/max_count, set (fixed params), check (set keys the pre-submit check enforces), medias / medias_by_mode placeholders, ref_role, raw (whole params for remove_background)"
  },
